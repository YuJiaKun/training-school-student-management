# 运行环境。生产部署请使用 production。
NODE_ENV=production

# Node 服务监听端口；Nginx 示例会反向代理到 127.0.0.1:3000。
PORT=3000

# 数据文件路径。建议放在独立数据目录，便于备份和权限管理。
DATA_FILE=/var/lib/training-school-student-management/data.json

# 登录账号配置，使用 JSON 数组。上线前请修改用户名和密码，不要保留 change-me 或默认演示密码。
# role 支持 admin、teacher、student；teacher 账号可配置 teacherId，student 账号可配置 studentId。
AUTH_ACCOUNTS=[{"username":"admin","password":"change-me-admin","role":"admin"},{"username":"teacher01","password":"change-me-teacher","role":"teacher","teacherId":1},{"username":"student01","password":"change-me-student","role":"student","studentId":1}]

# 是否只通过 HTTPS 发送 Cookie。线上启用 HTTPS 时建议设置为 true。
COOKIE_SECURE=true

# 登录会话有效期，单位为秒。这里示例为 7 天。
SESSION_MAX_AGE_SECONDS=604800
